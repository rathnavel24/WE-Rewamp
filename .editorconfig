# Keeps every editor consistent with Prettier. UTF-8 everywhere — a file saved in another
# encoding (e.g. by PowerShell's Set-Content) breaks the build.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
