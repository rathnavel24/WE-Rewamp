# Base URL of the WalletEdge backend API (no trailing slash), e.g. https://api.walletedgeglobal.com
# Leave empty during local development (`npm run dev`) to mock the API — the contact form will
# simulate a successful submission so the UI can be reviewed without a backend.
# Production builds never mock: without this set, the contact form shows an error with the
# group email address instead of pretending the enquiry was sent.
VITE_API_BASE_URL=

# Feature flags to switch on, comma-separated (see src/config/features.ts). Empty = all off.
# Example: VITE_FEATURES=aiAssistant
VITE_FEATURES=
